# Local development only. Generate the three cryptographic values with `npm run secrets`.
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
FACILITY_TIME_ZONE=Africa/Nairobi

# Matches backend/docker-compose.yml. Change this only for a different local database.
DATABASE_URL=postgres://mediflow:local-only-change-me@127.0.0.1:54329/mediflow
DATABASE_SSL=false
SESSION_PEPPER=replace-with-output-from-npm-run-secrets
OTP_HMAC_KEY=replace-with-output-from-npm-run-secrets
DATA_ENCRYPTION_KEY=replace-with-output-from-npm-run-secrets

OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Optional Africa's Talking OTP credentials for sandbox/live SMS.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENV=sandbox

MPESA_PROVIDER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

WHATSAPP_PROVIDER=mock
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEAM_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

TRIAGE_STAFF_COUNT=1
CONSULTATION_STAFF_COUNT=2
LAB_STAFF_COUNT=2
PHARMACY_STAFF_COUNT=1
